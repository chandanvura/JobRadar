{
  "manifest_version": 3,
  "name": "JobRadar 1-Click Autofill",
  "version": "1.0.0",
  "description": "1-click autofill for job applications on Greenhouse, Lever, Workday, and Ashby directly from JobRadar.",
  "icons": {
    "48": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobRadar Autofill"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://careers.smartrecruiters.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
