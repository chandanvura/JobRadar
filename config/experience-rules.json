{
  "max_minimum_experience_years": 3,
  "optional": "\\b(?:preferred|preferably|nice to have|good to have|a plus|desirable|bonus|optional|not (?:required|mandatory|necessary|essential))\\b",
  "junior": "\\b(?:freshers?|fresh graduates?|new graduates?|entry.?level|early career|campus hire|university graduate|recent graduates?|no (?:prior |professional |work )?experience (?:is )?required)\\b",
  "exclude": "\\b(?:degree|course|contract|tenure|warranty|bond|graduation|bachelor|master|phd)\\b",
  "words": {
    "zero": 0,
    "one": 1,
    "two": 2,
    "three": 3,
    "four": 4,
    "five": 5,
    "six": 6,
    "seven": 7,
    "eight": 8,
    "nine": 9,
    "ten": 10,
    "eleven": 11,
    "twelve": 12
  },
  "patterns": [
    {
      "kind": "range",
      "pattern": "\\b(\\d+(?:\\.\\d+)?)\\s*(years?|yrs?|yoe|months?|mos?)?\\s*(?:-|\u2013|\u2014|to)\\s*(\\d+(?:\\.\\d+)?)\\s*\\+?\\s*(years?|yrs?|yoe|months?|mos?)\\b"
    },
    {
      "kind": "upper",
      "pattern": "\\b(?:up\\s*to|less than|maximum(?: of)?|max\\.?)\\s*(\\d+(?:\\.\\d+)?)\\s*(years?|yrs?|yoe|months?|mos?)\\b"
    },
    {
      "kind": "upper",
      "pattern": "\\b(\\d+(?:\\.\\d+)?)\\s*(years?|yrs?|yoe|months?|mos?)\\s*(?:or less|or fewer|maximum|at most)\\b"
    },
    {
      "kind": "lower",
      "pattern": "\\b(?:at least|minimum(?: of)?|more than|over|minimum\\s+(?:relevant\\s+|professional\\s+|work\\s+)?experience(?:\\s+of)?\\s*[:=-]?)\\s*(\\d+(?:\\.\\d+)?)\\s*\\+?\\s*(years?|yrs?|yoe|months?|mos?)\\b"
    },
    {
      "kind": "lower",
      "pattern": "\\b(\\d+(?:\\.\\d+)?)\\s*\\+\\s*(years?|yrs?|yoe|months?|mos?)\\b"
    },
    {
      "kind": "lower",
      "pattern": "\\b(\\d+(?:\\.\\d+)?)\\s*(years?|yrs?|yoe|months?|mos?)\\s*(?:minimum|or more|and above)\\b"
    },
    {
      "kind": "exact",
      "pattern": "\\b(\\d+(?:\\.\\d+)?)\\s*(years?|yrs?|yoe|months?|mos?)\\b"
    }
  ],
  "fragment_split": "(?:,\\s*(?=preferably\\b))|(?:,\\s*|\\s+(?:and|but)\\s+)(?=(?:(?:preferably|preferred|minimum(?: of)?|at least|maximum(?: of)?|up to)\\s+)?(?:\\d|zero\\b|one\\b|two\\b|three\\b|four\\b|five\\b|six\\b|seven\\b|eight\\b|nine\\b|ten\\b|eleven\\b|twelve\\b))",
  "junior_excluded": "\\b(?:no freshers?|(?:freshers?|fresh graduates?|new graduates?|entry.?level|recent graduates?)\\s+(?:are\\s+|is\\s+)?(?:not\\s+(?:eligible|accepted|suitable)|(?:need|should)\\s+not\\s+apply)|(?:not (?:open|suitable) (?:to|for))\\s+(?:freshers?|graduates?))\\b",
  "overall_scope": "\\b(?:overall|total|professional|work)\\s+experience\\b",
  "duration_prefix": "\\b(?:within|for\\s+(?:the\\s+)?(?:first|next|initial)|(?:training|probation|notice)(?:\\s+period)?(?:\\s+of)?)\\s*$"
}
