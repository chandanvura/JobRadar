{
  "name": "jobradar-cloudflare",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "install:ci": "npm ci --no-audit --no-fund",
    "dev": "wrangler dev --local --ip 127.0.0.1 --config wrangler.local.jsonc",
    "build": "node scripts/build.mjs",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "start": "wrangler dev --local --ip 127.0.0.1 --config wrangler.local.jsonc",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "test:product": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck:ui": "tsc --project tsconfig.ui.json",
    "test:api": "node tests/worker-api.integration.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "db:migrate:local": "wrangler d1 migrations apply jobradar-db --local --config wrangler.local.jsonc"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.46.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "jsdom": "26.1.0",
    "miniflare": "4.20260730.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wrangler": "4.151.3",
    "@eslint/js": "9.39.4",
    "typescript-eslint": "8.72.0",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "type": "module",
  "displayName": "JobRadar",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "fflate": "0.8.3",
    "sharp": "0.35.5",
    "undici": "7.29.1"
  }
}
