{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "components/**/*.tsx",
    "lib/**/*.ts",
    "main.tsx"
  ],
  "exclude": [
    "node_modules",
    "worker",
    "db",
    "dist"
  ]
}
